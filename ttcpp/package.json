{
  "name": "ttcpp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx test/api.test.ts && tsx test/google-maps.test.ts && tsx test/mcp.test.ts && tsx test/velocity.test.ts && tsx test/crowding.test.ts",
    "test:google-live": "node --env-file=../.env --import tsx test/google-maps.live.test.ts",
    "test:live": "node --env-file=../.env --import tsx test/live-api.test.ts",
    "server": "node --env-file=../.env --import tsx server/index.ts",
    "dev:frontend": "vite --config app/vite.config.ts",
    "dev:app": "concurrently --kill-others \"npm run server\" \"npm run dev:frontend\"",
    "dev": "npm run dev:app",
    "build": "tsc --noEmit && vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.18",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
