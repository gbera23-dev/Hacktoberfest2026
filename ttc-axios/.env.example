# Required for TTC stop, route, arrival and vehicle-position requests.
TTC_API_KEY=replace-with-ttc-api-key

# Required by the browser map and by the serverless Google route/Places proxy.
# Restrict this key to your Netlify domain and the APIs used by the app.
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# Required for the TTC assistant chat endpoint.
GEMINI_API_KEY=replace-with-gemini-api-key

# Optional until the What-if simulator is enabled with a real provider key.
WHAT_IF_API_KEY=my-key

# Optional: set to true to use the bundled Google Maps mock responses.
GOOGLE_MAPS_USE_MOCK=false
